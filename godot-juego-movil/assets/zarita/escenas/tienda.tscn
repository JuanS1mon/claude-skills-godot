[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/tienda.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/item_tienda.tscn" id="3_item"]
[ext_resource type="Theme" path="res://themes/zarita.tres" id="4_tema"]
[ext_resource type="Script" path="res://scripts/scroll_deslizable.gd" id="6_scroll"]
[ext_resource type="Texture2D" path="res://assets/ui/iconos/anuncio.png" id="5_anuncio"]

[node name="Tienda" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("4_tema")
script = ExtResource("1_script")
escena_item = ExtResource("3_item")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -450.0
offset_right = 300.0
offset_bottom = 450.0
grow_horizontal = 2
grow_vertical = 2

[node name="Caja" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Titulo" type="Label" parent="Panel/Caja"]
layout_mode = 2
text = "Tienda"
horizontal_alignment = 1

[node name="Pestanas" type="HBoxContainer" parent="Panel/Caja"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Panel/Caja"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3
script = ExtResource("6_scroll")

[node name="Lista" type="VBoxContainer" parent="Panel/Caja/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Aviso" type="Label" parent="Panel/Caja"]
layout_mode = 2
horizontal_alignment = 1

[node name="BotonAnuncio" type="Button" parent="Panel/Caja"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_constants/icon_max_width = 56
text = "Ver anuncio (+3 gemas)"
icon = ExtResource("5_anuncio")
expand_icon = true

[node name="BotonCerrar" type="Button" parent="Panel/Caja"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
text = "Cerrar"
